    "test": "jest --runInBand",
    "test:browser": "node scripts/test-browser.cjs",
    "assets:store": "node scripts/store-assets.cjs",
    "audit:publication": "node scripts/audit-publication.cjs",
    "audit:store": "node scripts/audit-store.cjs",
    "package": "node scripts/package.cjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
