    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.7",
    "jest": "^30.4.2",
    "jsdom": "^21.1.1",
    "node-forge": "^1.3.1",
    "selenium-webdriver": "^4.23.0",
    "ts-jest": "^29.3.4",
    "typescript": "^5.0.4"
  }
}
