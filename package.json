{
  "name": "orderstash",
  "version": "0.1.0",
  "private": true,
  "description": "A Chrome extension for free Amazon invoice PDFs and order CSV exports.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run typecheck && node scripts/build.cjs",
